<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Stutter Diagnostic - per-machine, x64 MSI.

  Payload  : $(var.PublishRoot)\service | \gui | \cli  (see StutterDiag.Installer.wixproj header
             for the exact `dotnet publish ... -o publish\{service|gui|cli}` commands).
  Docs     : taken straight from the repo tree ($(var.DocsDir)), so they are always present.
  Service  : name "StutterDiag.Service", display name "Windows Stutter Diagnostic Service".
             Start="demand" by default; `msiexec /i StutterDiag.msi AUTOSTART=1` flips the SCM
             start type to Automatic (delayed) via a registry write.
  Upgrade  : MajorUpgrade + a fixed UpgradeCode; component GUIDs are auto (Guid="*").
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Windows Stutter Diagnostic"
           Manufacturer="StutterDiag"
           Version="$(var.Version)"
           UpgradeCode="6E9B8E8A-2C4D-4E1A-9E7F-2A1B3C4D5E6F"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Windows Stutter Diagnostic - local, no-telemetry stutter and correlation recorder" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Launch Condition="VersionNT64" Message="[ProductName] requires 64-bit Windows." />

    <!-- Public + secured so it survives the elevation hand-off when set on the command line. -->
    <Property Id="AUTOSTART" Value="0" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="StutterDiag">
        <Directory Id="DOCSFOLDER" Name="docs" />
      </Directory>
    </StandardDirectory>
<?ifdef HasPayload ?>
    <!-- Guarded: the only component in this folder is GuiShortcut, and its RemoveFolder is what
         keeps ICE64 happy. Declaring the folder in the no-payload skeleton build would leave a
         start-menu directory with no RemoveFile row, which ICE64 rejects. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="Windows Stutter Diagnostic" />
    </StandardDirectory>
<?endif ?>

    <Feature Id="Main" Title="Windows Stutter Diagnostic" Level="1">
<?ifdef HasPayload ?>
      <ComponentGroupRef Id="ServicePayload" />
      <ComponentGroupRef Id="GuiPayload" />
      <ComponentGroupRef Id="CliPayload" />
      <ComponentRef Id="ServiceExe" />
      <ComponentRef Id="GuiShortcut" />
<?else ?>
      <ComponentRef Id="SkeletonMarker" />
<?endif ?>
      <ComponentRef Id="AutostartRegistry" />
      <ComponentGroupRef Id="DocFiles" />
    </Feature>

    <!-- AUTOSTART=1: turn the SCM start type to 2 (Automatic) and mark it delayed.
         Otherwise ServiceInstall's Start="demand" stands. -->
    <Component Id="AutostartRegistry" Directory="INSTALLFOLDER" Guid="*" Condition="AUTOSTART = &quot;1&quot;">
      <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\StutterDiag.Service"
                     Name="Start" Type="integer" Value="2" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\StutterDiag.Service"
                     Name="DelayedAutostart" Type="integer" Value="1" />
    </Component>

<?ifndef HasPayload ?>
    <!-- No published payload: keep the MSI linkable so the solution build stays green. -->
    <Component Id="SkeletonMarker" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKLM" Key="SOFTWARE\StutterDiag" Name="InstallDir" Type="string"
                     Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>
<?endif ?>

    <!-- Minimal WixUI. AUTOSTART deliberately has no checkbox: a control cannot be added to a
         standard WixUI dialog, because redeclaring InstallDirDlg here duplicates the symbol the
         WixUI_InstallDir wixlib already owns (WIX0091). Set it on the command line instead:
         msiexec /i StutterDiag.msi AUTOSTART=1 -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="WixUI_ErrorProgressText" />

  </Package>

<?ifdef HasPayload ?>
  <Fragment>
    <!-- Bulk service payload, everything except the exe itself (which needs its own component
         for ServiceInstall/ServiceControl). appsettings.json is harvested here if published. -->
    <ComponentGroup Id="ServicePayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishRoot)\service\**">
        <Exclude Files="$(var.PublishRoot)\service\StutterDiag.Service.exe" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="GuiPayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishRoot)\gui\**" />
    </ComponentGroup>

    <ComponentGroup Id="CliPayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishRoot)\cli\**" />
    </ComponentGroup>

    <Component Id="ServiceExe" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
      <File Id="filStutterDiagServiceExe"
            Source="$(var.PublishRoot)\service\StutterDiag.Service.exe" KeyPath="yes" />
      <ServiceInstall Id="siStutterDiagService"
                      Name="StutterDiag.Service"
                      DisplayName="Windows Stutter Diagnostic Service"
                      Description="Background collector: detects stutters and records the surrounding Windows activity for later temporal correlation. No telemetry."
                      Type="ownProcess"
                      Start="demand"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="yes" />
      <ServiceControl Id="scStutterDiagService"
                      Name="StutterDiag.Service"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <Component Id="GuiShortcut" Directory="ShortcutFolder" Guid="*">
      <Shortcut Id="scutGui"
                Name="Windows Stutter Diagnostic"
                Description="Open the Windows Stutter Diagnostic GUI"
                Target="[INSTALLFOLDER]StutterDiag.Gui.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="rmShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="SOFTWARE\StutterDiag" Name="gui" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
<?endif ?>

  <Fragment>
    <!-- docs\ come from the repo tree so this always resolves. -->
    <ComponentGroup Id="DocFiles" Directory="DOCSFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
  </Fragment>

</Wix>
