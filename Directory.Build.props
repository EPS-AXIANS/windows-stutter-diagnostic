<Project>

  <!--
    Solution-wide MSBuild defaults for Windows Stutter Diagnostic.
    Individual projects override TargetFramework where a Windows-only
    surface (WPF, WMI) is required (net8.0-windows).
  -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(IsPackable)' != 'true'"></RuntimeIdentifier>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
    <Company>StutterDiag</Company>
    <Product>Windows Stutter Diagnostic</Product>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Copyright>Local diagnostic tool. No telemetry.</Copyright>
    <!-- CA1416: platform-compat analyzer; we guard Windows calls at runtime and target Win10+ only. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

</Project>
