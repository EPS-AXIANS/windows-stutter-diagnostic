<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>StutterDiag.Etw</RootNamespace>
    <AssemblyName>StutterDiag.Etw</AssemblyName>
    <!-- ETW real-time sessions are Windows-only. Everything here assumes Win10+ x64. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StutterDiag.Core\StutterDiag.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Version comes from Directory.Packages.props (CPM). Do not add Version= here. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>

</Project>
