<UserControl x:Class="StutterDiag.Gui.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:StutterDiag.Gui.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Timeline" Style="{StaticResource H1}" />

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Marks are placed on a seconds axis from the session start. Wheel to zoom, drag to pan, click a mark to inspect it. Positions show what was observed near each other — not cause and effect." />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Session" VerticalAlignment="Center" Style="{StaticResource Muted}"
                       Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="#" /><Run Text="{Binding Id, Mode=OneWay}" />
                            <Run Text="  " /><Run Text="{Binding StartedUtcIso, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding Label, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding Mode, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Grid.Column="2" Content="Reload sessions" Command="{Binding LoadSessionsCommand}"
                    Margin="10,0,0,0" />

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Content="Fit" Click="OnFitClick" Margin="0,0,6,0" />
                <Button Content="◀ Prev stutter" Command="{Binding JumpPrevStutterCommand}" Margin="0,0,6,0" />
                <Button Content="Next stutter ▶" Command="{Binding JumpNextStutterCommand}" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="0" Height="180" Margin="0,0,0,10">
            <controls:TimelineCanvas x:Name="TlCanvas"
                                     Items="{Binding TimelineItems}"
                                     TotalSeconds="{Binding TotalSeconds}"
                                     SelectedStutterId="{Binding SelectedStutterId, Mode=TwoWay}" />
        </Border>

        <Border Style="{StaticResource Card}" DockPanel.Dock="Top" VerticalAlignment="Top" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Selected mark" Style="{StaticResource H2}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding SelectedStutterDetail}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Stutter detail window (only populated for stutter / user-mark selections) -->
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SelectedWindow, Converter={StaticResource NullOrEmptyToVis}}">
            <Border Style="{StaticResource Card}" DataContext="{Binding SelectedWindow}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Margin="0,0,0,2">
                        <Run Text="Stutter #" /><Run Text="{Binding StutterId, Mode=OneWay}" />
                        <Run Text="  ·  " /><Run Text="{Binding DurationMs, Mode=OneWay, StringFormat=N0}" /><Run Text=" ms" />
                        <Run Text="  ·  " /><Run Text="{Binding Severity, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Everything observed in the window around the stutter. Ordering shows co-occurrence, not cause." />

                    <UniformGrid Columns="4" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="CPU avg / peak" Style="{StaticResource Muted}" />
                            <TextBlock>
                                <Run Text="{Binding CpuAvgPct, Mode=OneWay, StringFormat=N0, TargetNullValue='—'}" />
                                <Run Text=" / " />
                                <Run Text="{Binding CpuPeakPct, Mode=OneWay, StringFormat=N0, TargetNullValue='—'}" />
                                <Run Text=" %" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="GPU avg" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding GpuAvgPct, Mode=OneWay, StringFormat={}{0:N0} %, TargetNullValue='Unavailable'}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Disk latency spike" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding DiskLatencySpikeMs, Mode=OneWay, StringFormat={}{0:N1} ms, TargetNullValue='—'}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="DPC peak" Style="{StaticResource Muted}" />
                            <TextBlock>
                                <Run Text="{Binding DpcPeakMs, Mode=OneWay, StringFormat=N1, TargetNullValue='—'}" />
                                <Run Text=" ms " />
                                <Run Text="{Binding DpcPeakDriver, Mode=OneWay, TargetNullValue=''}" />
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Possible correlations (temporal proximity only)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Correlations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="9" Padding="8,2" VerticalAlignment="Top"
                                            Background="{Binding Score, Converter={StaticResource ScoreBrush}}">
                                        <TextBlock Text="{Binding Score}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Detail, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No signals correlated within the window." Style="{StaticResource Muted}"
                               Visibility="{Binding Correlations.Count, Converter={StaticResource NullOrEmptyToVis}, ConverterParameter=Invert}" />

                    <TextBlock Text="Top processes in the snapshot" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <ItemsControl ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,1">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text=" (pid " /><Run Text="{Binding Pid, Mode=OneWay}" /><Run Text=")  " />
                                    <Run Text="{Binding CpuPercent, Mode=OneWay, StringFormat={}{0:N0}% CPU}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Grid />
    </DockPanel>
</UserControl>
