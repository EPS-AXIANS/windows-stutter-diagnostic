<Window x:Class="StutterDiag.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StutterDiag.Gui.ViewModels"
        xmlns:views="clr-namespace:StutterDiag.Gui.Views"
        Title="StutterDiag" Height="760" Width="1180"
        MinHeight="520" MinWidth="900"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <views:SystemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimelineViewModel}">
            <views:TimelineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventsViewModel}">
            <views:EventsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompareViewModel}">
            <views:CompareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- App-wide, non-blocking service-availability banner. -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bad}" Padding="12,7"
                Visibility="{Binding Service.IsServiceAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <TextBlock Text="{Binding Service.ServiceStateText}"
                       Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="StutterDiag" FontSize="16" FontWeight="Bold"
                               Margin="16,16,16,4" />
                    <TextBlock DockPanel.Dock="Top" Text="Local diagnostic — no telemetry"
                               Style="{StaticResource Muted}" FontSize="10" Margin="16,0,16,12" />

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Key}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0" Cursor="Hand">
                                    <TextBlock Text="{Binding Label}" FontSize="13" />
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="16,9" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualsMulti}">
                                                            <Binding Path="Key" />
                                                            <Binding Path="DataContext.CurrentKey"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource Brush.NavSelected}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock DockPanel.Dock="Bottom" Margin="16,8"
                               Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"
                               Text="Observations and hypotheses only. This tool never claims one component caused a stutter." />
                    <Grid />
                </DockPanel>
            </Border>

            <!-- Page host -->
            <ContentControl Grid.Column="1" Margin="0" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
