<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. Same keys as Light.xaml. -->

    <Color x:Key="Color.Window">#1E1E1E</Color>
    <Color x:Key="Color.Surface">#252526</Color>
    <Color x:Key="Color.Card">#2D2D30</Color>
    <Color x:Key="Color.Border">#3C3C3C</Color>
    <Color x:Key="Color.Text">#E6E6E6</Color>
    <Color x:Key="Color.Muted">#9A9A9A</Color>
    <Color x:Key="Color.Accent">#4F9CF0</Color>
    <Color x:Key="Color.AccentText">#0F2438</Color>
    <Color x:Key="Color.Good">#66BB6A</Color>
    <Color x:Key="Color.Warn">#E0A030</Color>
    <Color x:Key="Color.Bad">#EF5350</Color>
    <Color x:Key="Color.NavHover">#333337</Color>
    <Color x:Key="Color.NavSelected">#223B57</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Good" Color="{StaticResource Color.Good}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.Bad" Color="{StaticResource Color.Bad}" />
    <SolidColorBrush x:Key="Brush.NavHover" Color="{StaticResource Color.NavHover}" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="{StaticResource Color.NavSelected}" />

</ResourceDictionary>
