<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette. Keys are consumed via DynamicResource so the whole dictionary
         can be swapped at runtime to follow the OS theme. -->

    <Color x:Key="Color.Window">#F3F3F3</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Card">#FFFFFF</Color>
    <Color x:Key="Color.Border">#DCDCDC</Color>
    <Color x:Key="Color.Text">#1A1A1A</Color>
    <Color x:Key="Color.Muted">#6B6B6B</Color>
    <Color x:Key="Color.Accent">#1565C0</Color>
    <Color x:Key="Color.AccentText">#FFFFFF</Color>
    <Color x:Key="Color.Good">#2E7D32</Color>
    <Color x:Key="Color.Warn">#B46A00</Color>
    <Color x:Key="Color.Bad">#C62828</Color>
    <Color x:Key="Color.NavHover">#E8E8E8</Color>
    <Color x:Key="Color.NavSelected">#E0ECFA</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Good" Color="{StaticResource Color.Good}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.Bad" Color="{StaticResource Color.Bad}" />
    <SolidColorBrush x:Key="Brush.NavHover" Color="{StaticResource Color.NavHover}" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="{StaticResource Color.NavSelected}" />

</ResourceDictionary>
